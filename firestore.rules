rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School LMS CBT rules for MAN 11 Jakarta
    match /users/{userId} {
      allow read, write: if true;
    }
    match /rombels/{rombelId} {
      allow read, write: if true;
    }
    match /mataPelajaran/{mapelId} {
      allow read, write: if true;
    }
    match /kelasMapelPengampu/{kmpId} {
      allow read, write: if true;
    }
    match /exams/{examId} {
      allow read, write: if true;
    }
    match /materials/{materialId} {
      allow read, write: if true;
    }
    match /submissions/{submissionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
